# Normalize text to LF everywhere, including on Windows checkouts.
* text=auto eol=lf
# Flaky-test logs are kept exactly as captured (CRLF included).
docs/reports/flaky/*.log -text

# Word documents and other binaries: never diff or convert.
*.docx binary
*.doc binary
*.dotx binary
*.png binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
